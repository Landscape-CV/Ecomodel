{
  "dataset_dir": "testdataset/instance_smoke",
  "area_size": 20.0,
  "pool_size_per_species": 2,
  "num_workers": 2,
  "replicates": 1,
  "num_scans_range": [2, 2],
  "height_range": [8.0, 12.0],
  "compositions": ["mixed", "mono"],
  "max_species": 2,
  "densities": {
    "sparse": {
      "num_trees": 2,
      "placement_mode": "spread",
      "min_spacing": 8.0,
      "max_spacing": null
    },
    "dense": {
      "num_trees": 4,
      "placement_mode": "cluster",
      "min_spacing": 0.5,
      "max_spacing": 4.0
    }
  },
  "noise": {
    "resolution_theta_deg": 1.0,
    "resolution_phi_deg": 1.0,
    "distance_noise_std": 0.005,
    "wind_sway_std": 0.0,
    "beam_divergence_noise_std": 0.0,
    "voxel_downsample_size": 0.05,
    "wind_x": 0.0,
    "wind_y": 0.0
  },
  "label_schema": {
    "ground": -1,
    "clutter": -2,
    "trees": ">=0"
  }
}
